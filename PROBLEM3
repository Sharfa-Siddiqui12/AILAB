          "text": [
            "Route exists between Kolkata and Pune\n",
            "\n",
            "Connected Components:\n",
            "Component 1 : ['Kolkata', 'Mumbai', 'Pune', 'Delhi', 'Jaipur']\n",
            "Component 2 : ['Chennai', 'Bangalore']\n",
            "Component 3 : ['Hyderabad']\n"
          ]
        }
      ],
      "source": [
        "graph = {\n",
        "    \"Kolkata\": [\"Delhi\", \"Mumbai\"],\n",
        "    \"Delhi\": [\"Kolkata\", \"Jaipur\"],\n",
        "    \"Mumbai\": [\"Kolkata\", \"Pune\"],\n",
        "    \"Jaipur\": [\"Delhi\"],\n",
        "    \"Pune\": [\"Mumbai\"],\n",
        "    \"Chennai\": [\"Bangalore\"],\n",
        "    \"Bangalore\": [\"Chennai\"],\n",
        "    \"Hyderabad\": []\n",
        "}\n",
        "\n",
        "\n",
        "def route_exists(graph, start, destination, visited=None):\n",
        "    if visited is None:\n",
        "        visited = set()\n",
        "\n",
        "    if start == destination:\n",
        "        return True\n",
        "\n",
        "    visited.add(start)\n",
        "\n",
        "    for city in graph[start]:\n",
        "        if city not in visited:\n",
        "            if route_exists(graph, city, destination, visited):\n",
        "                return True\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "\n",
        "def find_components(graph):\n",
        "    visited = set()\n",
        "    components = []\n",
        "\n",
        "    for city in graph:\n",
        "        if city not in visited:\n",
        "            component = []\n",
        "            stack = [city]\n",
        "\n",
        "            while stack:\n",
        "                current = stack.pop()\n",
        "\n",
        "                if current not in visited:\n",
        "                    visited.add(current)\n",
        "                    component.append(current)\n",
        "\n",
        "                    for neighbor in graph[current]:\n",
        "                        if neighbor not in visited:\n",
        "                            stack.append(neighbor)\n",
        "\n",
        "            components.append(component)\n",
        "\n",
        "    return components\n",
        "\n",
        "\n",
        "\n",
        "start = \"Kolkata\"\n",
        "destination = \"Pune\"\n",
        "\n",
        "if route_exists(graph, start, destination):\n",
        "    print(\"Route exists between\", start, \"and\", destination)\n",
        "else:\n",
        "    print(\"No route exists between\", start, \"and\", destination)\n",
        "\n",
        "\n",
        "\n",
        "components = find_components(graph)\n",
        "\n",
        "print(\"\\nConnected Components:\")\n",
        "for i, component in enumerate(components, 1):\n",
        "    print(\"Component\", i, \":\", component)"
      ]
